// ==================== MIGRATE / SETUP ====================
function migrateData() {
  const ss = getSS();
  const studentsSheet = ss.getSheetByName(SHEET_NAMES.STUDENTS);
  const subjectsSheet = ss.getSheetByName(SHEET_NAMES.SUBJECTS);
  const assignSheet = ss.getSheetByName(SHEET_NAMES.ASSIGNMENTS);
  const scoresSheet = ss.getSheetByName(SHEET_NAMES.SCORES);

  [studentsSheet, subjectsSheet, assignSheet, scoresSheet].forEach(sheet => {
    if (sheet.getLastRow() > 1) {
      sheet.getRange(2, 1, sheet.getLastRow()-1, sheet.getLastColumn()).clearContent();
    }
  });

  if (MIG_STUDENTS.length) studentsSheet.getRange(2,1,MIG_STUDENTS.length,3).setValues(MIG_STUDENTS);
  if (MIG_SUBJECTS.length) subjectsSheet.getRange(2,1,MIG_SUBJECTS.length,6).setValues(MIG_SUBJECTS);
  if (MIG_ASSIGNMENTS.length) assignSheet.getRange(2,1,MIG_ASSIGNMENTS.length,9).setValues(MIG_ASSIGNMENTS);
  if (MIG_SCORES.length) scoresSheet.getRange(2,1,MIG_SCORES.length,6).setValues(MIG_SCORES);
  return `✅ Migrate: ${MIG_STUDENTS.length} นร., ${MIG_SUBJECTS.length} วิชา, ${MIG_ASSIGNMENTS.length} งาน, ${MIG_SCORES.length} คะแนน`;
}

function setupEverything() {
  Logger.log(initializeDatabase());
  Utilities.sleep(500);
  Logger.log(migrateData());
  Logger.log('✅ เสร็จสิ้น');
}

// ==================== CRUD: ASSIGNMENTS ====================
function addAssignment(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.ASSIGNMENTS);
  const data = sheet.getDataRange().getValues();
  let maxOrder = 0;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === payload.subjectCode && String(data[i][1]).trim() === payload.section) {
      maxOrder = Math.max(maxOrder, Number(data[i][2]));
    }
  }
  const newOrder = maxOrder + 1;
  sheet.appendRow([
    payload.subjectCode, payload.section, newOrder, payload.name,
    Number(payload.max), payload.isPercent ? 'TRUE' : '',
    payload.link || '', payload.dueDate || '', payload.note || '',
    payload.kpaType || '', payload.attrTypes || '', Number(payload.unitNo) || 0
  ]);
  return { success: true, order: newOrder };
}

function updateAssignment(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.ASSIGNMENTS);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === payload.subjectCode &&
        String(data[i][1]).trim() === payload.section &&
        Number(data[i][2]) === payload.order) {
      sheet.getRange(i+1, 4).setValue(payload.name);
      sheet.getRange(i+1, 5).setValue(Number(payload.max));
      sheet.getRange(i+1, 6).setValue(payload.isPercent ? 'TRUE' : '');
      sheet.getRange(i+1, 7).setValue(payload.link || '');
      sheet.getRange(i+1, 8).setValue(payload.dueDate || '');
      sheet.getRange(i+1, 9).setValue(payload.note || '');
      sheet.getRange(i+1, 11).setValue(payload.attrTypes || '');
      sheet.getRange(i+1, 12).setValue(Number(payload.unitNo) || 0);
      return { success: true };
    }
  }
  return { success: false, error: 'ไม่พบงาน' };
}

function deleteAssignment(subjectCode, section, order) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.ASSIGNMENTS);
  const data = sheet.getDataRange().getValues();
  let assignRow = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === subjectCode && String(data[i][1]).trim() === section && Number(data[i][2]) === order) {
      assignRow = i + 1; break;
    }
  }
  if (assignRow === -1) return { success: false, error: 'ไม่พบงาน' };
  sheet.deleteRow(assignRow);

  const nd = sheet.getDataRange().getValues();
  const items = [];
  for (let i = 1; i < nd.length; i++) {
    if (String(nd[i][0]).trim() === subjectCode && String(nd[i][1]).trim() === section) {
      items.push({ row: i+1, order: Number(nd[i][2]) });
    }
  }
  items.sort((a,b) => a.order - b.order);
  items.forEach((item, idx) => { if (item.order !== idx+1) sheet.getRange(item.row, 3).setValue(idx+1); });

  const scoresSheet = ss.getSheetByName(SHEET_NAMES.SCORES);
  const sd = scoresSheet.getDataRange().getValues();
  const toDel = [];
  for (let i = 1; i < sd.length; i++) {
    if (String(sd[i][0]).trim() === subjectCode && String(sd[i][1]).trim() === section && Number(sd[i][3]) === order) {
      toDel.push(i+1);
    }
  }
  toDel.reverse().forEach(r => scoresSheet.deleteRow(r));

  const rem = scoresSheet.getDataRange().getValues();
  for (let i = 1; i < rem.length; i++) {
    if (String(rem[i][0]).trim() === subjectCode && String(rem[i][1]).trim() === section) {
      const ord = Number(rem[i][3]);
      if (ord > order && ord > 0) scoresSheet.getRange(i+1, 4).setValue(ord - 1);
    }
  }
  return { success: true };
}

// ==================== CRUD: SCORES ====================
function updateScore(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.SCORES);
  const data = sheet.getDataRange().getValues();
  const sid = normalizeId(payload.studentId);
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === payload.subjectCode &&
        String(data[i][1]).trim() === payload.section &&
        normalizeId(data[i][2]) === sid &&
        Number(data[i][3]) === payload.order) {
      if (payload.score === null || payload.score === '' || payload.score === undefined) {
        sheet.getRange(i+1, 5).setValue('');
      } else {
        sheet.getRange(i+1, 5).setValue(Number(payload.score));
      }
      return { success: true };
    }
  }
  if (payload.score !== null && payload.score !== '' && payload.score !== undefined) {
    sheet.appendRow([payload.subjectCode, payload.section, sid, payload.order, Number(payload.score), '']);
    return { success: true, added: true };
  }
  return { success: true };
}

// ==================== BATCH SAVE SCORES ====================
function batchSaveScores(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.SCORES);
  const data = sheet.getDataRange().getValues();

  const idx = {};
  for (let i = 1; i < data.length; i++) {
    const k = String(data[i][0]).trim() + '|' + String(data[i][1]).trim() + '|' +
              normalizeId(data[i][2]) + '|' + Number(data[i][3]);
    idx[k] = i + 1;
  }

  const updates = [];
  const toAdd = [];

  (payload.scores || []).forEach(item => {
    const sid = normalizeId(item.studentId);
    const k = payload.subjectCode + '|' + payload.section + '|' + sid + '|' + item.order;
    const row = idx[k];
    const scoreVal = (item.score === null || item.score === undefined || item.score === '')
      ? '' : Number(item.score);
    const attrDataStr = item.attrData ? JSON.stringify(item.attrData) : '';

    if (row) {
      updates.push({ row: row, value: scoreVal, attr: attrDataStr });
    } else if (scoreVal !== '' || attrDataStr !== '') {
      toAdd.push([payload.subjectCode, payload.section, sid, item.order, scoreVal, '', attrDataStr]);
    }
  });

  updates.forEach(u => {
    sheet.getRange(u.row, 5).setValue(u.value);
    sheet.getRange(u.row, 7).setValue(u.attr);
  });

  if (toAdd.length) {
    const startRow = sheet.getLastRow() + 1;
    sheet.getRange(startRow, 1, toAdd.length, 7).setValues(toAdd);
  }

  SpreadsheetApp.flush();
  return { success: true, updated: updates.length, added: toAdd.length };
}

// ==================== REMARK: UPDATE / DELETE ====================
function updateRemark(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.SCORES);
  const data = sheet.getDataRange().getValues();
  const sid = normalizeId(payload.studentId);
  const section = String(payload.section || 'remark').trim();
  const remark = String(payload.remark || '').trim();

  let foundRow = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === payload.subjectCode &&
        String(data[i][1]).trim() === section &&
        normalizeId(data[i][2]) === sid &&
        Number(data[i][3]) === 0) {
      foundRow = i + 1; break;
    }
  }

  if (!remark) {
    if (foundRow > 0) sheet.deleteRow(foundRow);
    SpreadsheetApp.flush();
    return { success: true, deleted: true };
  }

  if (foundRow > 0) {
    sheet.getRange(foundRow, 6).setValue(remark);
  } else {
    sheet.appendRow([payload.subjectCode, section, sid, 0, 0, remark]);
  }
  SpreadsheetApp.flush();
  return { success: true };
}

// ==================== THEME: SAVE TO CONFIG ====================
function saveThemeToConfig(theme) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.CONFIG);
  const data = sheet.getDataRange().getValues();
  const val = String(theme || 'default').trim() || 'default';
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === 'theme') {
      sheet.getRange(i + 1, 2).setValue(val);
      SpreadsheetApp.flush();
      return { success: true };
    }
  }
  sheet.appendRow(['theme', val]);
  SpreadsheetApp.flush();
  return { success: true };
}

// ==================== CRUD: STUDENTS ====================
function addStudent(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.STUDENTS);
  const data = sheet.getDataRange().getValues();
  const nid = normalizeId(payload.id);
  for (let i = 1; i < data.length; i++) {
    if (normalizeId(data[i][0]) === nid) {
      return { success: false, error: 'มีรหัส ' + nid + ' อยู่แล้ว' };
    }
  }
  sheet.appendRow([nid, payload.name, payload.grade]);
  return { success: true, id: nid };
}

function updateStudent(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.STUDENTS);
  const data = sheet.getDataRange().getValues();
  const nid = normalizeId(payload.id);
  for (let i = 1; i < data.length; i++) {
    if (normalizeId(data[i][0]) === nid) {
      sheet.getRange(i+1, 2).setValue(payload.name);
      sheet.getRange(i+1, 3).setValue(payload.grade);
      return { success: true };
    }
  }
  return { success: false, error: 'ไม่พบนักเรียน' };
}

function deleteStudent(id) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.STUDENTS);
  const data = sheet.getDataRange().getValues();
  const nid = normalizeId(id);
  for (let i = 1; i < data.length; i++) {
    if (normalizeId(data[i][0]) === nid) {
      sheet.deleteRow(i+1);
      const scoresSheet = ss.getSheetByName(SHEET_NAMES.SCORES);
      const sd = scoresSheet.getDataRange().getValues();
      const toDel = [];
      for (let j = 1; j < sd.length; j++) {
        if (normalizeId(sd[j][2]) === nid) toDel.push(j+1);
      }
      toDel.reverse().forEach(r => scoresSheet.deleteRow(r));
      return { success: true };
    }
  }
  return { success: false, error: 'ไม่พบนักเรียน' };
}

