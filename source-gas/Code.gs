const SHEET_NAMES = {
  STUDENTS: 'Students', SUBJECTS: 'Subjects',
  ASSIGNMENTS: 'Assignments', SCORES: 'Scores', CONFIG: 'Config',
  ATTENDANCE: 'Attendance', UNITS: 'Units'
};

// ==================== HELPER: เปิด Spreadsheet ====================
function getSS() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

// ==================== WEB APP ====================
function doGet(e) {
  return HtmlService.createHtmlOutputFromFile('Index')
    .setTitle('ระบบสารสนเทศ ปพ.5 - Dashboard')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

// ==================== HELPERS ====================
function normalizeId(id) {
  if (id === null || id === undefined || id === '') return '';
  const s = String(id).trim();
  if (!/^\d+$/.test(s)) return s;
  return s.padStart(5, '0');
}

function formatThaiDateTime(val) {
  if (!val) return '-';
  try {
    const d = (val instanceof Date) ? val : new Date(val);
    if (isNaN(d.getTime())) return String(val);
    const thaiMonths = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน',
                        'กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
    const hh = String(d.getHours()).padStart(2,'0');
    const mm = String(d.getMinutes()).padStart(2,'0');
    return `${hh}:${mm} น. ${d.getDate()} ${thaiMonths[d.getMonth()]} ${d.getFullYear()+543}`;
  } catch(e) { return String(val); }
}

function formatThaiDate(val) {
  if (!val) return '';
  if (val instanceof Date) {
    const thaiMonths = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน',
                        'กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
    return `${val.getDate()} ${thaiMonths[val.getMonth()]} ${val.getFullYear()+543}`;
  }
  return String(val).trim();
}

function getLastUpdatedString() {
  try {
    const ss = getSS();
    const file = DriveApp.getFileById(ss.getId());
    return formatThaiDateTime(file.getLastUpdated());
  } catch(e) {
    return formatThaiDateTime(new Date());
  }
}

// ==================== API: GET DATA ====================
function getInitialData() {
  const ss = getSS();

  // Students
  const stSheet = ss.getSheetByName(SHEET_NAMES.STUDENTS);
  const studentsRows = stSheet.getDataRange().getValues().slice(1).filter(r => r[0]);
  const students = studentsRows.map(r => ({
    id: normalizeId(r[0]), name: String(r[1]).trim(), grade: String(r[2]).trim()
  }));

  // Subjects
  const sjSheet = ss.getSheetByName(SHEET_NAMES.SUBJECTS);
  const subjectsRows = sjSheet.getDataRange().getValues().slice(1).filter(r => r[0]);
  const subjects = subjectsRows.map(r => ({
    code: String(r[0]).trim(), name: String(r[1]).trim(), grade: String(r[2]).trim(),
    hoursPerWeek: Number(r[3]), totalHours: Number(r[4]), term: Number(r[5])
  }));


  // Units
  const unitSheet = ss.getSheetByName(SHEET_NAMES.UNITS);
  const unitRows = unitSheet ? unitSheet.getDataRange().getValues().slice(1).filter(r => r[0]) : [];
  const units = unitRows.map(r => ({
    subjectCode: String(r[0]).trim(),
    unitNo: Number(r[1]),
    unitName: String(r[2]).trim(),
    indicators: String(r[3]).trim(),
    hours: Number(r[4]),
    maxScore: Number(r[5]),
    char8: String(r[6] || '').trim(),
    comp5: String(r[7] || '').trim()
  }));

  // Assignments
  const aSheet = ss.getSheetByName(SHEET_NAMES.ASSIGNMENTS);
  const aRows = aSheet.getDataRange().getValues().slice(1).filter(r => r[0]);
  const assignmentMeta = {};
  const sectionDetails = {};

  aRows.forEach(r => {
    const code = String(r[0]).trim();
    const section = String(r[1]).trim();
    const order = Number(r[2]);
    const name = String(r[3]).trim();
    const max = Number(r[4]);
    const isPercent = String(r[5]).toUpperCase() === 'TRUE';
    const link = r[6] ? String(r[6]).trim() : '';
    const dueDate = r[7] ? formatThaiDate(r[7]) : '';
    const note = r[8] ? String(r[8]).trim() : '';
    const kpaType = r[9] ? String(r[9]).trim() : '';
    const attrTypes = r[10] ? String(r[10]).trim() : '';
    const unitNo = r[11] ? Number(r[11]) : 0;

    if (!assignmentMeta[code]) assignmentMeta[code] = { pre: [], post: [], mid: [], final: [] };
    if (!sectionDetails[code]) sectionDetails[code] = {};
    if (!sectionDetails[code][section]) sectionDetails[code][section] = { assignments: [], scores: {} };

    const obj = { name, max, order, unitNo };
    if (isPercent) obj.isPercent = true;
    if (link) obj.link = link;
    if (dueDate) obj.dueDate = dueDate;
    if (note) obj.note = note;
    if (attrTypes) obj.attrTypes = attrTypes;
    assignmentMeta[code][section].push(obj);
    sectionDetails[code][section].assignments.push(obj);
  });

  Object.keys(sectionDetails).forEach(code => {
    Object.keys(sectionDetails[code]).forEach(sec => {
      sectionDetails[code][sec].assignments.sort((a,b) => (a.order||0) - (b.order||0));
    });
  });

  // Scores
  const scSheet = ss.getSheetByName(SHEET_NAMES.SCORES);
  const sRows = scSheet.getDataRange().getValues().slice(1).filter(r => r[0]);
  const sectionRemarks = {};

  sRows.forEach(r => {
    const code = String(r[0]).trim();
    const section = String(r[1]).trim();
    const studentId = normalizeId(r[2]);
    const order = Number(r[3]);
    const scoreVal = r[4];
    const remark = String(r[5] || '').trim();
    const attrDataStr = r[6] ? String(r[6]).trim() : '';
    let attrData = {};
    if (attrDataStr) { try { attrData = JSON.parse(attrDataStr); } catch(e){} }

    if (!sectionDetails[code]) sectionDetails[code] = {};
    if (!sectionDetails[code][section]) sectionDetails[code][section] = { assignments: [], scores: {} };
    if (!sectionDetails[code][section].scores[studentId]) {
      sectionDetails[code][section].scores[studentId] = [];
    }
    if (order > 0) {
      const score = (scoreVal === '' || scoreVal === null) ? null : Number(scoreVal);
      sectionDetails[code][section].scores[studentId][order - 1] = score;
      if (Object.keys(attrData).length) {
        if (!sectionDetails[code][section].attrData) sectionDetails[code][section].attrData = {};
        if (!sectionDetails[code][section].attrData[studentId]) sectionDetails[code][section].attrData[studentId] = {};
        sectionDetails[code][section].attrData[studentId][order - 1] = attrData;
      }
    } else if (order === 0 && remark) {
      if (!sectionRemarks[code]) sectionRemarks[code] = {};
      if (!sectionRemarks[code][section]) sectionRemarks[code][section] = {};
      sectionRemarks[code][section][studentId] = remark;
    }
  });

  // Attendance
  const attSheet = ss.getSheetByName(SHEET_NAMES.ATTENDANCE);
  const attRows = attSheet ? attSheet.getDataRange().getValues().slice(1).filter(r => r[0]) : [];
  const attendance = {};

  attRows.forEach(r => {
    const dateStr = (r[0] instanceof Date)
      ? Utilities.formatDate(r[0], 'Asia/Bangkok', 'yyyy-MM-dd')
      : String(r[0]).trim();
    const code = String(r[1]).trim();
    const sid = normalizeId(r[2]);
    const status = String(r[3]).trim();
    const hours = Number(r[4]) || 1;

    if (!attendance[code]) attendance[code] = {};
    if (!attendance[code][dateStr]) attendance[code][dateStr] = { hours: hours, records: {} };
    attendance[code][dateStr].records[sid] = status;
  });

  // Config (รวม theme)
  const cfgSheet = ss.getSheetByName(SHEET_NAMES.CONFIG);
  const cfgRows = cfgSheet.getDataRange().getValues().slice(1).filter(r => r[0]);
  const config = {};
  const configRaw = {};
  cfgRows.forEach(r => {
    const k = String(r[0]).trim();
    configRaw[k] = r[1];
    config[k] = formatThaiDateTime(r[1]);
  });
  config.theme = String(configRaw.theme || 'default').trim() || 'default';
  config.lastUpdate = getLastUpdatedString();

  return { students, subjects, units, assignmentMeta, sectionDetails, sectionRemarks, attendance, config };
}

// ==================== INIT DATABASE ====================
function initializeDatabase() {
  const ss = getSS();
  function ensureSheet(name, headers) {
    let sheet = ss.getSheetByName(name);
    if (!sheet) sheet = ss.insertSheet(name);
    sheet.clear();
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#f0f0f0');
    sheet.setFrozenRows(1);
    return sheet;
  }
  ensureSheet(SHEET_NAMES.STUDENTS, ['id','name','grade']);
  ensureSheet(SHEET_NAMES.SUBJECTS, ['code','name','grade','hoursPerWeek','totalHours','term']);
  ensureSheet(SHEET_NAMES.ASSIGNMENTS, ['subjectCode','section','order','name','max','isPercent','link','dueDate','note','kpa_type','attr_types','unitNo']);
  ensureSheet(SHEET_NAMES.UNITS, ['subjectCode','unitNo','unitName','indicators','hours','maxScore','char8','comp5']);
  ensureSheet(SHEET_NAMES.SCORES, ['subjectCode','section','studentId','order','score','remark','attr_data']);
  ensureSheet(SHEET_NAMES.ATTENDANCE, ['date','subjectCode','studentId','status','hours','note']);
  const cfgSheet = ensureSheet(SHEET_NAMES.CONFIG, ['key','value']);
  cfgSheet.getRange(2, 1, 4, 2).setNumberFormat('@');
  cfgSheet.getRange(2, 1, 4, 2).setValues([
    ['teacherPassword','1234'],
    ['lastUpdate','28 กันยายน 2569'],
    ['systemName','ระบบสารสนเทศ ปพ.5'],
    ['theme','default']
  ]);
  const def = ss.getSheetByName('Sheet1');
  if (def && ss.getSheets().length > 5) ss.deleteSheet(def);
  return '✅ สร้างฐานข้อมูลเรียบร้อย';
}

