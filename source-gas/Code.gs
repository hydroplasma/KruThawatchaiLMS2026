// ==================== ATTENDANCE ====================
function saveAttendance(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.ATTENDANCE);
  const data = sheet.getDataRange().getValues();

  const dateStr = payload.date; // YYYY-MM-DD
  const code = payload.subjectCode;
  const hours = Number(payload.hours) || 1;
  const records = payload.records; // { studentId: status }

  // 1. ลบข้อมูลการเช็คชื่อของวันและวิชานี้ที่มีอยู่เดิมออกก่อน (เพื่อบันทึกทับ)
  for (let i = data.length - 1; i >= 1; i--) {
    const rowDate = data[i][0] instanceof Date ? Utilities.formatDate(data[i][0], "Asia/Bangkok", "yyyy-MM-dd") : String(data[i][0]);
    if (rowDate === dateStr && String(data[i][1]).trim() === code) {
      sheet.deleteRow(i + 1);
    }
  }

  // 2. เตรียมข้อมูลใหม่เพื่อบันทึกทีเดียว
  const newRows = [];
  Object.keys(records).forEach(sid => {
    const status = records[sid];
    if (status) {
      newRows.push([dateStr, code, normalizeId(sid), status, hours, '']);
    }
  });

  // 3. บันทึกข้อมูลใหม่
  if (newRows.length > 0) {
    const startRow = sheet.getLastRow() + 1;
    sheet.getRange(startRow, 1, newRows.length, 6).setValues(newRows);

    // จัดฟอร์แมตคอลัมน์วันที่ให้เป็น Date
    const dateRange = sheet.getRange(startRow, 1, newRows.length, 1);
    dateRange.setNumberFormat('yyyy-mm-dd');
  }

  SpreadsheetApp.flush();
  return { success: true, saved: newRows.length };
}

// ฟังก์ชันสำหรับตรวจสอบรหัสครูจากชีต Config เซลล์ B2
function verifyTeacherPasswordFromSheet(inputPw) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Config");
  if (!sheet) return false;
  var correctPw = sheet.getRange("B2").getValue().toString().trim();
  return inputPw.toString().trim() === correctPw;
}

// ==================== CRUD: UNITS ====================
function saveUnit(payload) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.UNITS);
  const data = sheet.getDataRange().getValues();
  let foundRow = -1;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === payload.subjectCode && Number(data[i][1]) === Number(payload.unitNo)) {
      foundRow = i + 1; break;
    }
  }
  const rowValues = [
    payload.subjectCode, Number(payload.unitNo), payload.unitName,
    payload.indicators || '', Number(payload.hours) || 0, Number(payload.maxScore) || 0,
    payload.char8 || '', payload.comp5 || ''
  ];
  if (foundRow > 0) {
    sheet.getRange(foundRow, 1, 1, rowValues.length).setValues([rowValues]);
  } else {
    sheet.appendRow(rowValues);
  }
  SpreadsheetApp.flush();
  return { success: true };
}

function deleteUnit(subjectCode, unitNo) {
  const ss = getSS();
  const sheet = ss.getSheetByName(SHEET_NAMES.UNITS);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][0]).trim() === subjectCode && Number(data[i][1]) === Number(unitNo)) {
      sheet.deleteRow(i + 1);
      SpreadsheetApp.flush();
      return { success: true };
    }
  }
  return { success: false, error: 'ไม่พบหน่วยการเรียนรู้' };
}
